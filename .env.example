# Groq API Configuration (Get your free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,.onrender.com,*

# Frontend API Target:
# - For Local / Render / Single Container: http://127.0.0.1:8000/api/analyze/
# - For Docker Compose (two separate containers): http://backend:8000/api/analyze/
API_URL=http://127.0.0.1:8000/api/analyze/
